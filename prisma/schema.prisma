datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Image {
  id        Int      @id @default(autoincrement())
  user      String?
  userId    String?
  image     String   @db.Text
  filename  String?  @db.Text
  channelId String?
  messageId String?  @unique
  time      DateTime @default(now())

  @@map("images")
}

model Log {
  id        Int      @id @default(autoincrement())
  user      String?
  userId    String?
  message   String?  @db.Text
  time      DateTime @default(now())

  @@map("logs")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())

  @@map("users")
}

model MediaJob {
  id             Int      @id @default(autoincrement())
  title          String?
  type           String   // 'video' | 'image'
  mediaUrl       String   @db.Text
  thumbnailUrl   String?  @db.Text
  cutDuration    Float?   // Cut video duration in seconds (<= 60s)
  displayMinutes Int      @default(30) // Duration in seconds (10, 15, 30, 45, 60, 90, 120s)
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED, CANCELLED
  submittedBy    String?
  approvedBy     String?
  playOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("media_jobs")
}
